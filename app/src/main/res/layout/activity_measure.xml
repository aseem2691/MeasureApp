<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Full Screen AR View -->
    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/scene_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- iOS-style Overlay for 3D Labels -->
    <com.example.measureapp.ar.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Compact Dark Floating Pill -->
    <androidx.cardview.widget.CardView
        android:id="@+id/measurement_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:minWidth="120dp"
        app:cardBackgroundColor="#B31C1C1E"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center">

            <TextView
                android:id="@+id/prompt_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Point at a surface"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="280dp" />

            <TextView
                android:id="@+id/measurement_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Tap + to add point"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Right Side Controls -->
    <LinearLayout
        android:id="@+id/right_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Undo Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/undo_card"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#CC1C1C1E"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <ImageView
                android:id="@+id/undo_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_undo"
                android:tint="#FFFFFF"
                android:contentDescription="Undo"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </androidx.cardview.widget.CardView>

        <!-- Clear Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/clear_card"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            app:cardBackgroundColor="#CC1C1C1E"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <ImageView
                android:id="@+id/clear_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_delete"
                android:tint="#FFFFFF"
                android:contentDescription="Clear"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </androidx.cardview.widget.CardView>

        <!-- Screenshot / Capture Button (thumb-reach, near power button) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/capture_button_card"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#CC1C1C1E"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <ImageView
                android:id="@+id/capture_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_camera"
                android:tint="#FFFFFF"
                android:contentDescription="Capture"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Measure Mode Selector — iOS-style segmented control (Line / Height / Area) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mode_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#B31C1C1E"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/mode_line_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/segment_selected"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Line"
                android:textColor="#000000"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/mode_height_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Height"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/mode_area_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Area"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Control Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_controls"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bottom_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Main Shutter Button — iOS camera-shutter style: white ring + white disk -->
        <FrameLayout
            android:id="@+id/add_button_card"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/shutter_ring"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:id="@+id/add_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless">

                <View
                    android:id="@+id/inner_circle"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_inner" />

                <ImageView
                    android:id="@+id/plus_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plus"
                    android:tint="#1C1C1E"
                    android:contentDescription="@string/add_point_label" />

            </FrameLayout>

        </FrameLayout>

        <!-- Done Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/done_button_card"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="48dp"
            android:visibility="gone"
            app:cardBackgroundColor="#34C759"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/add_button_card"
            app:layout_constraintEnd_toStartOf="@+id/add_button_card"
            app:layout_constraintTop_toTopOf="@+id/add_button_card">

            <ImageView
                android:id="@+id/done_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp"
                android:src="@drawable/ic_check"
                android:contentDescription="Done"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Help hint -->
    <TextView
        android:id="@+id/help_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rounded_background"
        android:gravity="center"
        android:text="Point at a textured surface (wood, tiles, fabric)\nand move your phone slowly side to side"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/mode_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
